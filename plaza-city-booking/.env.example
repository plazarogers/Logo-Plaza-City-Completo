# Copia este archivo a .env y ajusta los valores.
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# Base de datos SQLite (un archivo). En producción monta un volumen persistente.
DB_PATH=data/plaza-city.db

# Secreto largo y aleatorio para firmar sesiones (obligatorio en producción):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Llave del dueño del edificio para generar/revocar links de invitación
# desde /invitaciones. Obligatoria en producción. Usa algo largo y aleatorio.
OWNER_KEY=

# Web Push (VAPID). Genera con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@plazacity.net

# Reglas (opcionales; valores por defecto entre paréntesis)
# BOOKING_WINDOW_DAYS=30            # anticipación máxima (30 días)
# MAX_HOURS_PER_BOOKING=4           # horas contiguas por apartado (4)
# MAX_HOURS_PER_USER_PER_DAY=4      # cuota diaria por usuario y espacio (4)
# CHECKIN_OPENS_MINUTES_BEFORE=15   # el check-in se abre X min antes (15)
# CHECKIN_GRACE_MINUTES=15          # sin check-in X min después: se libera (15)
# CANCEL_LOCK_IN_MINUTES=0          # límite para cancelar antes del inicio (0)
# INVITE_DEFAULT_DAYS=7             # validez de un link de invitación (7)
# HOLIDAYS_EXTRA_FILE=data/holidays.extra.json
